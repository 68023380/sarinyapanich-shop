# คัดลอกค่าต่อไปนี้ไปใส่ใน .env ของ Backend
# ใช้ Database connection string จาก Supabase > Connect > URI
SUPABASE_DB_URL=postgresql://postgres:[YOUR_DATABASE_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# ใช้ตอนต้องการสลับ Backend ไปอ่าน PostgreSQL หลังทดสอบ migration แล้ว
DB_DRIVER=postgres
SUPABASE_DB_SSL=true
DB_POOL_MAX=10

# ค่าเดิมของระบบยังต้องมี
PORT=3000
JWT_SECRET=เปลี่ยนเป็นค่าสุ่มยาวอย่างน้อย 32 ตัวอักษร
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
UPLOAD_DIR=./uploads
DATABASE_FILE=./data/shop.db
